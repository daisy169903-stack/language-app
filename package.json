{
  "name": "vietlingo-hu",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.md",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "android:sync": "cap sync android",
    "android:build": "powershell -NoProfile -File scripts/package-android.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/browser": "8.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "tsx": "^4.19.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "3.6.2",
    "electron": "45.3.0",
    "@capacitor/cli": "8.6.0"
  }
}
